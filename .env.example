# Neon or other managed PostgreSQL connection string. Keep this secret.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
APP_URL="http://localhost:3000"

# Generate a random 32+ character value; used to sign secure session cookies.
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Optional: enables server-side OpenAI-compatible AI requests (never expose to the browser).
AI_API_KEY=""
AI_API_URL="https://api.openai.com/v1/chat/completions"
AI_MODEL="gpt-4o-mini"

# Optional: bootstrap an admin once with `npm.cmd run db:seed`.
# Use a unique strong password; the seed command only promotes the configured email.
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""

# Optional: configure SMTP and APP_URL to enable actual password-reset email delivery.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
